{
  "notes": "Updated: SSH/Sea level comes from GLOBAL_ANALYSISFORECAST_PHY_001_024 hourly sea-level dataset (covers into Mar 2026). This avoids DUACS L4 MY time limit. SST/thetao, currents/uo+vo, waves/VHM0, CHL as before.",
  "cmems": {
    "sst": {
      "dataset_id": "cmems_mod_glo_phy-thetao_anfc_0.083deg_PT6H-i",
      "variable": "thetao",
      "depth_m": 0,
      "units": "degrees_C",
      "convert": null
    },
    "chl": {
      "dataset_id": "cmems_obs-oc_glo_bgc-plankton_nrt_l4-gapfree-multi-4km_P1D",
      "variable": "CHL",
      "units": "milligram m-3",
      "convert": null
    },
    "currents": {
      "dataset_id": "cmems_mod_glo_phy-cur_anfc_0.083deg_PT6H-i",
      "variables": [
        "uo",
        "vo"
      ],
      "depth_m": 0,
      "units": "m s-1",
      "convert": null
    },
    "ssh": {
      "dataset_id": "cmems_mod_glo_phy_anfc_merged-sl_PT1H-i",
      "variable": "zos",
      "units": "m",
      "convert": null,
      "notes": "Sea level, hourly. Variable typically 'zos' (sea surface height)."
    },
    "waves": {
      "dataset_id": "cmems_mod_glo_wav_anfc_0.083deg_PT3H-i",
      "variable": "VHM0",
      "units": "m",
      "convert": null
    },
    "sst_obs": {
      "dataset_id": "METOFFICE-GLO-SST-L4-NRT-OBS-SST-V2",
      "variable": "analysed_sst",
      "units": "kelvin",
      "convert": "K_TO_C",
      "notes": "Optional alternative SST source (OSTIA). Code converts Kelvin -> Celsius if used."
    }
  }
}
